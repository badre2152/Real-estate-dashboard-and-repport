
Rang Ville par Prix =
RANKX(
    ALL(v_annonces_full[ville]),
    [Prix Moyen],
    ,
    DESC,
    DENSE
)

Part Marché Ville =
DIVIDE(
    [Total Annonces],
    CALCULATE([Total Annonces], ALL(v_annonces_full[ville]))
)

Annonces Grandes Villes =
CALCULATE(
    [Total Annonces],
    v_annonces_full[is_grande_ville] = TRUE
)

Prix Moyen par Region =
[Prix Moyen]

Prix Moyen Quartier =
CALCULATE(
    AVERAGE(v_annonces_full[prix]),
    v_annonces_full[quartier_known] = TRUE
)

Top Ville =
VAR ranked_cities =
    TOPN(
        1,
        ALLSELECTED(v_annonces_full[ville]),
        [Total Annonces], DESC,
        v_annonces_full[ville], ASC
    )
RETURN
    CONCATENATEX(ranked_cities, v_annonces_full[ville], ", ")
